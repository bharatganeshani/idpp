# ─────────────────────────────────────────────────────────────
# AI Book Classification System — Backend Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The .env file is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# NVIDIA API Key (required)
# Get yours at: https://integrate.api.nvidia.com
api_key=nvapi-YOUR_KEY_HERE

# API endpoint (default shown — change only if using a different provider)
api_endpoint=https://integrate.api.nvidia.com/v1/chat/completions

# Model to use (default shown)
model=moonshotai/kimi-k2.6
