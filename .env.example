# ── Environment Variables ──────────────────────────────────────────────────────
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to git.

# Nvidia / OpenAI-compatible API
api_key=YOUR_NVIDIA_API_KEY_HERE
api_endpoint=https://integrate.api.nvidia.com/v1/chat/completions
model=moonshotai/kimi-k2.6

# Production settings
FLASK_ENV=production

# CORS — set to your Netlify frontend URL in production
# Example: https://nexus-ai.netlify.app
FRONTEND_URL=http://localhost:8080

# SQLite path override (used on Render with persistent disk)
# Leave empty to use default (backend/users.db) for local dev
# On Render set to: /var/data/users.db
DB_PATH=
